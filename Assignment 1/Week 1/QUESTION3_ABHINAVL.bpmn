  <bpmn:process id="Process_ITServiceRequest" name="IT Service Request" isExecutable="false">
    <bpmn:startEvent id="S3_Start" name="Employee reports IT problem" />
    <bpmn:task id="S3_Submit" name="Submit IT support request" />
    <bpmn:task id="S3_Register" name="Register request" />
    <bpmn:task id="S3_CheckSeverity" name="Check problem severity" />
    <bpmn:exclusiveGateway id="S3_G1" name="Severity?" />
    <bpmn:task id="S3_Low" name="Assign to support technician" />
    <bpmn:task id="S3_High" name="Assign to senior technician" />
    <bpmn:task id="S3_Investigate" name="Investigate problem" />
    <bpmn:exclusiveGateway id="S3_G2" name="Can be resolved internally?" />
    <bpmn:task id="S3_Fix" name="Fix problem" />
    <bpmn:task id="S3_Escalate" name="Escalate to external service provider" />
    <bpmn:task id="S3_Update" name="Update request status" />
    <bpmn:task id="S3_Notify" name="Send resolution notification" />
    <bpmn:endEvent id="S3_End" name="Request resolved" />
    <bpmn:sequenceFlow id="S3F1" sourceRef="S3_Start" targetRef="S3_Submit" />
    <bpmn:sequenceFlow id="S3F2" sourceRef="S3_Submit" targetRef="S3_Register" />
