    <bpmn:sequenceFlow id="S3F7" sourceRef="S3_Low" targetRef="S3_Investigate" />
    <bpmn:sequenceFlow id="S3F8" sourceRef="S3_High" targetRef="S3_Investigate" />
    <bpmn:sequenceFlow id="S3F9" sourceRef="S3_Investigate" targetRef="S3_G2" />
    <bpmn:sequenceFlow id="S3F10" name="Yes" sourceRef="S3_G2" targetRef="S3_Fix" />
    <bpmn:sequenceFlow id="S3F11" name="No" sourceRef="S3_G2" targetRef="S3_Escalate" />
    <bpmn:sequenceFlow id="S3F12" sourceRef="S3_Fix" targetRef="S3_Update" />
