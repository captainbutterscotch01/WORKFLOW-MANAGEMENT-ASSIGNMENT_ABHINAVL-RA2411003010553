<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_A2" targetNamespace="http://example.org/bpmn" exporter="bpmn-generator" exporterVersion="1.0">
  <bpmn:message id="Msg_delay" name="Delay reported"/>
  <bpmn:message id="Msg_cancel" name="Cancellation request"/>
  <bpmn:message id="Msg_rpl" name="Recipient proposes new slot"/>
  <bpmn:error id="Err_docs" name="Documents not provided"/>
  <bpmn:error id="Err_addr" name="Address not found"/>
  <bpmn:error id="Err_scan" name="Scan / system failure"/>
  <bpmn:error id="Err_cus" name="Customs hold unresolved"/>
  <bpmn:collaboration id="Collab_A2">
    <bpmn:participant id="P_main" name="Logistics &amp; Shipment Exception Management" processRef="Process_A2"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_A2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_shp" name="Shipper / Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_book</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_corr</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_pck" name="Pickup Agent">
        <bpmn:flowNodeRef>t_pick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_pk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ps</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ct" name="Control Tower / Dispatcher">
        <bpmn:flowNodeRef>t_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_val</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_brej</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_pay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_refund</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sched</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pcnt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_cfee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_pc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_track</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_dnote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_alt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_eta</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_trace</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_5d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_lost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>sub_cus</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_cerr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_close</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_ok</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_hub" name="Hub / Warehouse">
        <bpmn:flowNodeRef>sub_tr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_delay</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_48</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_can</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_stop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_ct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cx</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_pj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recv</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_man</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_recon</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_scan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_chk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_insp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_sort</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rto</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_cj</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_dmg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_ins</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rec</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>m_dmg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_rts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_rts</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_dlv" name="Delivery Agent">
        <bpmn:flowNodeRef>m_try</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_ofd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_del</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>b_addr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>t_addr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_out</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_att</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>g_w</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_1d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>e_hold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_rcp" name="Recipient">
        <bpmn:flowNodeRef>e_rpl</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_clm" name="Claims Department">
        <bpmn:flowNodeRef>sub_cl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end_cl</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Shipper books shipment"><bpmn:outgoing>f_start_t_book</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="t_book" name="Create booking"><bpmn:incoming>f_start_t_book</bpmn:incoming><bpmn:incoming>f_t_corr_t_book</bpmn:incoming><bpmn:outgoing>f_t_book_t_val</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_corr" name="Correct booking details"><bpmn:incoming>f_g_cnt_t_corr</bpmn:incoming><bpmn:outgoing>f_t_corr_t_book</bpmn:outgoing></bpmn:userTask>
    <bpmn:businessRuleTask id="t_val" name="Validate address, weight &amp; service level; calculate price"><bpmn:incoming>f_t_book_t_val</bpmn:incoming><bpmn:outgoing>f_t_val_g_val</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="g_val" name="Booking valid?"><bpmn:incoming>f_t_val_g_val</bpmn:incoming><bpmn:outgoing>f_g_val_t_pay</bpmn:outgoing><bpmn:outgoing>f_g_val_g_cnt</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_cnt" name="Corrections &lt; 3?"><bpmn:incoming>f_g_val_g_cnt</bpmn:incoming><bpmn:outgoing>f_g_cnt_t_corr</bpmn:outgoing><bpmn:outgoing>f_g_cnt_end_brej</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_brej" name="Booking rejected"><bpmn:incoming>f_g_cnt_end_brej</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="t_pay" name="Take payment"><bpmn:incoming>f_g_val_t_pay</bpmn:incoming><bpmn:outgoing>f_t_pay_t_sched</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:boundaryEvent id="b_pay" cancelActivity="true" attachedToRef="t_pay"><bpmn:compensateEventDefinition/></bpmn:boundaryEvent>
    <bpmn:serviceTask id="t_refund" name="Refund payment minus cancellation fee" isForCompensation="true"></bpmn:serviceTask>
    <bpmn:serviceTask id="t_sched" name="Schedule pickup &amp; assign agent"><bpmn:incoming>f_t_pay_t_sched</bpmn:incoming><bpmn:incoming>f_g_pcnt_t_sched</bpmn:incoming><bpmn:outgoing>f_t_sched_t_pick</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="t_pick" name="Collect parcel &amp; scan label"><bpmn:incoming>f_t_sched_t_pick</bpmn:incoming><bpmn:outgoing>f_t_pick_g_ps</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="b_pk" name="Pickup window missed (shipper absent / not ready)" cancelActivity="true" attachedToRef="t_pick"><bpmn:outgoing>f_b_pk_g_pcnt</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="g_pcnt" name="Reschedules &lt; 2?"><bpmn:incoming>f_b_pk_g_pcnt</bpmn:incoming><bpmn:outgoing>f_g_pcnt_t_sched</bpmn:outgoing><bpmn:outgoing>f_g_pcnt_t_cfee</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="t_cfee" name="Cancel booking &amp; charge fee"><bpmn:incoming>f_g_pcnt_t_cfee</bpmn:incoming><bpmn:outgoing>f_t_cfee_end_pc</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_pc" name="Cancelled: pickup failed"><bpmn:incoming>f_t_cfee_end_pc</bpmn:incoming></bpmn:endEvent>
    <bpmn:parallelGateway id="g_ps"><bpmn:incoming>f_t_pick_g_ps</bpmn:incoming><bpmn:outgoing>f_g_ps_t_track</bpmn:outgoing><bpmn:outgoing>f_g_ps_sub_tr</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:sendTask id="t_track" name="Update tracking &amp; notify shipper"><bpmn:incoming>f_g_ps_t_track</bpmn:incoming><bpmn:outgoing>f_t_track_g_pj</bpmn:outgoing></bpmn:sendTask>
    <bpmn:subProcess id="sub_tr" name="Transport to destination hub (sub-process)"><bpmn:incoming>f_g_ps_sub_tr</bpmn:incoming><bpmn:outgoing>f_sub_tr_g_pj</bpmn:outgoing>
      <bpmn:startEvent id="i_s"><bpmn:outgoing>f_i_s_t_leg</bpmn:outgoing></bpmn:startEvent>
      <bpmn:serviceTask id="t_leg" name="Line-haul leg &amp; scan (one pass per hub leg)"><bpmn:incoming>f_i_s_t_leg</bpmn:incoming><bpmn:outgoing>f_t_leg_i_e</bpmn:outgoing><bpmn:multiInstanceLoopCharacteristics isSequential="true"/></bpmn:serviceTask>
      <bpmn:endEvent id="i_e"><bpmn:incoming>f_t_leg_i_e</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="f_i_s_t_leg" sourceRef="i_s" targetRef="t_leg"/>
      <bpmn:sequenceFlow id="f_t_leg_i_e" sourceRef="t_leg" targetRef="i_e"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_delay" name="Delay reported (weather / breakdown / overload)" cancelActivity="false" attachedToRef="sub_tr"><bpmn:outgoing>f_b_delay_t_dnote</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_delay"/></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_48" name="48 h: no scan" cancelActivity="true" attachedToRef="sub_tr"><bpmn:outgoing>f_b_48_t_trace</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT48H</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_can" name="Shipper cancels after dispatch" cancelActivity="true" attachedToRef="sub_tr"><bpmn:outgoing>f_b_can_t_stop</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_cancel"/></bpmn:boundaryEvent>
    <bpmn:sendTask id="t_dnote" name="Notify customer &amp; update ETA"><bpmn:incoming>f_b_delay_t_dnote</bpmn:incoming><bpmn:outgoing>f_t_dnote_t_alt</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="t_alt" name="Reroute / assign alternate vehicle"><bpmn:incoming>f_t_dnote_t_alt</bpmn:incoming><bpmn:outgoing>f_t_alt_end_eta</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_eta" name="ETA updated"><bpmn:incoming>f_t_alt_end_eta</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t_trace" name="Trace parcel (last scan, agents, CCTV)"><bpmn:incoming>f_b_48_t_trace</bpmn:incoming><bpmn:outgoing>f_t_trace_g_pj</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="b_5d" name="5 days: not found" cancelActivity="true" attachedToRef="t_trace"><bpmn:outgoing>f_b_5d_t_lost</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:serviceTask id="t_lost" name="Declare lost, pay compensation, notify customer"><bpmn:incoming>f_b_5d_t_lost</bpmn:incoming><bpmn:outgoing>f_t_lost_end_lost</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_lost" name="Lost"><bpmn:incoming>f_t_lost_end_lost</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="t_stop" name="Stop movement &amp; arrange return of parcel"><bpmn:incoming>f_b_can_t_stop</bpmn:incoming><bpmn:outgoing>f_t_stop_e_ct</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateThrowEvent id="e_ct" name="Compensate payment"><bpmn:incoming>f_t_stop_e_ct</bpmn:incoming><bpmn:outgoing>f_e_ct_end_cx</bpmn:outgoing><bpmn:compensateEventDefinition activityRef="t_pay"/></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_cx" name="Cancelled after dispatch"><bpmn:incoming>f_e_ct_end_cx</bpmn:incoming></bpmn:endEvent>
    <bpmn:parallelGateway id="g_pj"><bpmn:incoming>f_t_track_g_pj</bpmn:incoming><bpmn:incoming>f_sub_tr_g_pj</bpmn:incoming><bpmn:incoming>f_t_trace_g_pj</bpmn:incoming><bpmn:outgoing>f_g_pj_t_recv</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="t_recv" name="Receive &amp; scan parcel at hub"><bpmn:incoming>f_g_pj_t_recv</bpmn:incoming><bpmn:outgoing>f_t_recv_m_scan</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="b_scan" name="Scanner / system failure" cancelActivity="true" attachedToRef="t_recv"><bpmn:outgoing>f_b_scan_t_man</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Err_scan"/></bpmn:boundaryEvent>
    <bpmn:userTask id="t_man" name="Supervisor records scan manually"><bpmn:incoming>f_b_scan_t_man</bpmn:incoming><bpmn:outgoing>f_t_man_t_recon</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="t_recon" name="Reconcile tracking records"><bpmn:incoming>f_t_man_t_recon</bpmn:incoming><bpmn:outgoing>f_t_recon_m_scan</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="m_scan"><bpmn:incoming>f_t_recon_m_scan</bpmn:incoming><bpmn:incoming>f_t_recv_m_scan</bpmn:incoming><bpmn:outgoing>f_m_scan_g_chk</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:inclusiveGateway id="g_chk" name="Which checks apply?" default="f_g_chk_t_sort"><bpmn:incoming>f_m_scan_g_chk</bpmn:incoming><bpmn:outgoing>f_g_chk_sub_cus</bpmn:outgoing><bpmn:outgoing>f_g_chk_t_insp</bpmn:outgoing><bpmn:outgoing>f_g_chk_t_sort</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:userTask id="t_insp" name="Inspect parcel condition"><bpmn:incoming>f_g_chk_t_insp</bpmn:incoming><bpmn:outgoing>f_t_insp_g_cj</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="t_sort" name="Sort &amp; dispatch to delivery hub"><bpmn:incoming>f_g_chk_t_sort</bpmn:incoming><bpmn:outgoing>f_t_sort_g_cj</bpmn:outgoing></bpmn:userTask>
    <bpmn:subProcess id="sub_cus" name="Customs clearance (sub-process)"><bpmn:incoming>f_g_chk_sub_cus</bpmn:incoming><bpmn:outgoing>f_sub_cus_g_cj</bpmn:outgoing>
      <bpmn:startEvent id="c_s"><bpmn:outgoing>f_c_s_t_cchk</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="t_cchk" name="Check export / import documents"><bpmn:incoming>f_c_s_t_cchk</bpmn:incoming><bpmn:incoming>f_e_cdoc_t_cchk</bpmn:incoming><bpmn:outgoing>f_t_cchk_g_cok</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="g_cok" name="Documents complete?"><bpmn:incoming>f_t_cchk_g_cok</bpmn:incoming><bpmn:outgoing>f_g_cok_c_ok</bpmn:outgoing><bpmn:outgoing>f_g_cok_t_creq</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="c_ok" name="Cleared"><bpmn:incoming>f_g_cok_c_ok</bpmn:incoming></bpmn:endEvent>
      <bpmn:sendTask id="t_creq" name="Request documents from shipper"><bpmn:incoming>f_g_cok_t_creq</bpmn:incoming><bpmn:outgoing>f_t_creq_g_cev</bpmn:outgoing></bpmn:sendTask>
      <bpmn:eventBasedGateway id="g_cev" name="Await shipper" eventGatewayType="Exclusive"><bpmn:incoming>f_t_creq_g_cev</bpmn:incoming><bpmn:outgoing>f_g_cev_e_cdoc</bpmn:outgoing><bpmn:outgoing>f_g_cev_e_c5</bpmn:outgoing></bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="e_cdoc" name="Documents received"><bpmn:incoming>f_g_cev_e_cdoc</bpmn:incoming><bpmn:outgoing>f_e_cdoc_t_cchk</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_rpl"/></bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="e_c5" name="5 days: no documents"><bpmn:incoming>f_g_cev_e_c5</bpmn:incoming><bpmn:outgoing>f_e_c5_c_nd</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P5D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
      <bpmn:endEvent id="c_nd" name="Documents not provided"><bpmn:incoming>f_e_c5_c_nd</bpmn:incoming><bpmn:errorEventDefinition errorRef="Err_docs"/></bpmn:endEvent>
      <bpmn:sequenceFlow id="f_c_s_t_cchk" sourceRef="c_s" targetRef="t_cchk"/>
      <bpmn:sequenceFlow id="f_t_cchk_g_cok" sourceRef="t_cchk" targetRef="g_cok"/>
      <bpmn:sequenceFlow id="f_g_cok_c_ok" name="Yes" sourceRef="g_cok" targetRef="c_ok"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cok=="yes"}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_g_cok_t_creq" name="No" sourceRef="g_cok" targetRef="t_creq"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cok=="no"}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_t_creq_g_cev" sourceRef="t_creq" targetRef="g_cev"/>
      <bpmn:sequenceFlow id="f_g_cev_e_cdoc" sourceRef="g_cev" targetRef="e_cdoc"/>
      <bpmn:sequenceFlow id="f_g_cev_e_c5" sourceRef="g_cev" targetRef="e_c5"/>
      <bpmn:sequenceFlow id="f_e_c5_c_nd" sourceRef="e_c5" targetRef="c_nd"/>
      <bpmn:sequenceFlow id="f_e_cdoc_t_cchk" sourceRef="e_cdoc" targetRef="t_cchk"/>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_cerr" name="Customs hold unresolved" cancelActivity="true" attachedToRef="sub_cus"><bpmn:outgoing>f_b_cerr_t_rto</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Err_docs"/></bpmn:boundaryEvent>
    <bpmn:userTask id="t_rto" name="Return parcel to sender"><bpmn:incoming>f_b_cerr_t_rto</bpmn:incoming><bpmn:outgoing>f_t_rto_end_rto</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_rto" name="Returned to sender"><bpmn:incoming>f_t_rto_end_rto</bpmn:incoming></bpmn:endEvent>
    <bpmn:inclusiveGateway id="g_cj"><bpmn:incoming>f_sub_cus_g_cj</bpmn:incoming><bpmn:incoming>f_t_insp_g_cj</bpmn:incoming><bpmn:incoming>f_t_sort_g_cj</bpmn:incoming><bpmn:outgoing>f_g_cj_g_dmg</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:exclusiveGateway id="g_dmg" name="Damage found?" default="f_g_dmg_m_dmg"><bpmn:incoming>f_g_cj_g_dmg</bpmn:incoming><bpmn:outgoing>f_g_dmg_m_dmg</bpmn:outgoing><bpmn:outgoing>f_g_dmg_g_ins</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_ins" name="Insured?" default="f_g_ins_t_rec"><bpmn:incoming>f_g_dmg_g_ins</bpmn:incoming><bpmn:outgoing>f_g_ins_sub_cl</bpmn:outgoing><bpmn:outgoing>f_g_ins_t_rec</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_rec" name="Record damage &amp; inform shipper"><bpmn:incoming>f_g_ins_t_rec</bpmn:incoming><bpmn:outgoing>f_t_rec_m_dmg</bpmn:outgoing></bpmn:sendTask>
    <bpmn:exclusiveGateway id="m_dmg"><bpmn:incoming>f_g_dmg_m_dmg</bpmn:incoming><bpmn:incoming>f_t_rec_m_dmg</bpmn:incoming><bpmn:outgoing>f_m_dmg_m_try</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:subProcess id="sub_cl" name="Claims handling (sub-process)"><bpmn:incoming>f_g_ins_sub_cl</bpmn:incoming><bpmn:outgoing>f_sub_cl_end_cl</bpmn:outgoing>
      <bpmn:startEvent id="k_s"><bpmn:outgoing>f_k_s_t_asm</bpmn:outgoing></bpmn:startEvent>
      <bpmn:userTask id="t_asm" name="Assess claim &amp; evidence"><bpmn:incoming>f_k_s_t_asm</bpmn:incoming><bpmn:outgoing>f_t_asm_g_cl</bpmn:outgoing></bpmn:userTask>
      <bpmn:exclusiveGateway id="g_cl" name="Claim valid?"><bpmn:incoming>f_t_asm_g_cl</bpmn:incoming><bpmn:outgoing>f_g_cl_t_rem</bpmn:outgoing><bpmn:outgoing>f_g_cl_t_nrj</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="t_rem" name="Refund / replace / reship"><bpmn:incoming>f_g_cl_t_rem</bpmn:incoming><bpmn:outgoing>f_t_rem_k_e1</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:endEvent id="k_e1"><bpmn:incoming>f_t_rem_k_e1</bpmn:incoming></bpmn:endEvent>
      <bpmn:sendTask id="t_nrj" name="Notify claim rejected"><bpmn:incoming>f_g_cl_t_nrj</bpmn:incoming><bpmn:outgoing>f_t_nrj_k_e2</bpmn:outgoing></bpmn:sendTask>
      <bpmn:endEvent id="k_e2"><bpmn:incoming>f_t_nrj_k_e2</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="f_k_s_t_asm" sourceRef="k_s" targetRef="t_asm"/>
      <bpmn:sequenceFlow id="f_t_asm_g_cl" sourceRef="t_asm" targetRef="g_cl"/>
      <bpmn:sequenceFlow id="f_g_cl_t_rem" name="Yes" sourceRef="g_cl" targetRef="t_rem"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cl=="yes"}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_t_rem_k_e1" sourceRef="t_rem" targetRef="k_e1"/>
      <bpmn:sequenceFlow id="f_g_cl_t_nrj" name="No" sourceRef="g_cl" targetRef="t_nrj"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cl=="no"}</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="f_t_nrj_k_e2" sourceRef="t_nrj" targetRef="k_e2"/>
    </bpmn:subProcess>
    <bpmn:endEvent id="end_cl" name="Closed: claim settled"><bpmn:incoming>f_sub_cl_end_cl</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="m_try"><bpmn:incoming>f_m_dmg_m_try</bpmn:incoming><bpmn:incoming>f_t_addr_m_try</bpmn:incoming><bpmn:incoming>f_e_1d_m_try</bpmn:incoming><bpmn:incoming>f_e_rpl_m_try</bpmn:incoming><bpmn:outgoing>f_m_try_t_ofd</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="t_ofd" name="Notify recipient: out for delivery"><bpmn:incoming>f_m_try_t_ofd</bpmn:incoming><bpmn:outgoing>f_t_ofd_t_del</bpmn:outgoing></bpmn:sendTask>
    <bpmn:userTask id="t_del" name="Deliver parcel &amp; capture proof of delivery"><bpmn:incoming>f_t_ofd_t_del</bpmn:incoming><bpmn:outgoing>f_t_del_g_out</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="b_addr" name="Address incomplete / wrong at doorstep" cancelActivity="true" attachedToRef="t_del"><bpmn:outgoing>f_b_addr_t_addr</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Err_addr"/></bpmn:boundaryEvent>
    <bpmn:userTask id="t_addr" name="Contact recipient, confirm address (surcharge if changed)"><bpmn:incoming>f_b_addr_t_addr</bpmn:incoming><bpmn:outgoing>f_t_addr_m_try</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="g_out" name="Delivery outcome?"><bpmn:incoming>f_t_del_g_out</bpmn:incoming><bpmn:outgoing>f_g_out_t_close</bpmn:outgoing><bpmn:outgoing>f_g_out_t_rts</bpmn:outgoing><bpmn:outgoing>f_g_out_g_att</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="g_att" name="Attempts &lt; 3?" default="f_g_att_e_hold"><bpmn:incoming>f_g_out_g_att</bpmn:incoming><bpmn:outgoing>f_g_att_g_w</bpmn:outgoing><bpmn:outgoing>f_g_att_e_hold</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="g_w" name="Await recipient" eventGatewayType="Exclusive"><bpmn:incoming>f_g_att_g_w</bpmn:incoming><bpmn:outgoing>f_g_w_e_1d</bpmn:outgoing><bpmn:outgoing>f_g_w_e_rpl</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="e_1d" name="1 day elapsed"><bpmn:incoming>f_g_w_e_1d</bpmn:incoming><bpmn:outgoing>f_e_1d_m_try</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P1D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_rpl" name="Recipient proposes new slot"><bpmn:incoming>f_g_w_e_rpl</bpmn:incoming><bpmn:outgoing>f_e_rpl_m_try</bpmn:outgoing><bpmn:messageEventDefinition messageRef="Msg_rpl"/></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="e_hold" name="Hold at depot 7 days"><bpmn:incoming>f_g_att_e_hold</bpmn:incoming><bpmn:outgoing>f_e_hold_t_rts</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">P7D</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="t_rts" name="Arrange return to sender (adjust charges)"><bpmn:incoming>f_g_out_t_rts</bpmn:incoming><bpmn:incoming>f_e_hold_t_rts</bpmn:incoming><bpmn:outgoing>f_t_rts_end_rts</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_rts" name="Returned to sender"><bpmn:incoming>f_t_rts_end_rts</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="t_close" name="Close shipment &amp; generate invoice"><bpmn:incoming>f_g_out_t_close</bpmn:incoming><bpmn:outgoing>f_t_close_end_ok</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="end_ok" name="Shipment delivered &amp; closed"><bpmn:incoming>f_t_close_end_ok</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f_start_t_book" sourceRef="start" targetRef="t_book"/>
    <bpmn:sequenceFlow id="f_t_book_t_val" sourceRef="t_book" targetRef="t_val"/>
    <bpmn:sequenceFlow id="f_t_val_g_val" sourceRef="t_val" targetRef="g_val"/>
    <bpmn:sequenceFlow id="f_g_val_t_pay" name="Valid" sourceRef="g_val" targetRef="t_pay"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_val=="valid"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_val_g_cnt" name="Invalid" sourceRef="g_val" targetRef="g_cnt"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_val=="invalid"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_cnt_t_corr" name="Yes: back to shipper" sourceRef="g_cnt" targetRef="t_corr"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cnt=="yes_back_to_shipper"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_cnt_end_brej" name="No" sourceRef="g_cnt" targetRef="end_brej"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cnt=="no"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_t_corr_t_book" sourceRef="t_corr" targetRef="t_book"/>
    <bpmn:sequenceFlow id="f_t_pay_t_sched" sourceRef="t_pay" targetRef="t_sched"/>
    <bpmn:sequenceFlow id="f_t_sched_t_pick" sourceRef="t_sched" targetRef="t_pick"/>
    <bpmn:sequenceFlow id="f_b_pk_g_pcnt" sourceRef="b_pk" targetRef="g_pcnt"/>
    <bpmn:sequenceFlow id="f_g_pcnt_t_sched" name="Yes: reschedule" sourceRef="g_pcnt" targetRef="t_sched"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_pcnt=="yes_reschedule"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_pcnt_t_cfee" name="No" sourceRef="g_pcnt" targetRef="t_cfee"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_pcnt=="no"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_t_cfee_end_pc" sourceRef="t_cfee" targetRef="end_pc"/>
    <bpmn:sequenceFlow id="f_t_pick_g_ps" sourceRef="t_pick" targetRef="g_ps"/>
    <bpmn:sequenceFlow id="f_g_ps_t_track" sourceRef="g_ps" targetRef="t_track"/>
    <bpmn:sequenceFlow id="f_g_ps_sub_tr" sourceRef="g_ps" targetRef="sub_tr"/>
    <bpmn:sequenceFlow id="f_t_track_g_pj" sourceRef="t_track" targetRef="g_pj"/>
    <bpmn:sequenceFlow id="f_sub_tr_g_pj" sourceRef="sub_tr" targetRef="g_pj"/>
    <bpmn:sequenceFlow id="f_b_delay_t_dnote" sourceRef="b_delay" targetRef="t_dnote"/>
    <bpmn:sequenceFlow id="f_t_dnote_t_alt" sourceRef="t_dnote" targetRef="t_alt"/>
    <bpmn:sequenceFlow id="f_t_alt_end_eta" sourceRef="t_alt" targetRef="end_eta"/>
    <bpmn:sequenceFlow id="f_b_48_t_trace" sourceRef="b_48" targetRef="t_trace"/>
    <bpmn:sequenceFlow id="f_b_5d_t_lost" sourceRef="b_5d" targetRef="t_lost"/>
    <bpmn:sequenceFlow id="f_t_lost_end_lost" sourceRef="t_lost" targetRef="end_lost"/>
    <bpmn:sequenceFlow id="f_t_trace_g_pj" name="found" sourceRef="t_trace" targetRef="g_pj"/>
    <bpmn:sequenceFlow id="f_b_can_t_stop" sourceRef="b_can" targetRef="t_stop"/>
    <bpmn:sequenceFlow id="f_t_stop_e_ct" sourceRef="t_stop" targetRef="e_ct"/>
    <bpmn:sequenceFlow id="f_e_ct_end_cx" sourceRef="e_ct" targetRef="end_cx"/>
    <bpmn:sequenceFlow id="f_g_pj_t_recv" sourceRef="g_pj" targetRef="t_recv"/>
    <bpmn:sequenceFlow id="f_b_scan_t_man" sourceRef="b_scan" targetRef="t_man"/>
    <bpmn:sequenceFlow id="f_t_man_t_recon" sourceRef="t_man" targetRef="t_recon"/>
    <bpmn:sequenceFlow id="f_t_recon_m_scan" sourceRef="t_recon" targetRef="m_scan"/>
    <bpmn:sequenceFlow id="f_t_recv_m_scan" sourceRef="t_recv" targetRef="m_scan"/>
    <bpmn:sequenceFlow id="f_m_scan_g_chk" sourceRef="m_scan" targetRef="g_chk"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${m_scan=="ok"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_chk_sub_cus" name="International" sourceRef="g_chk" targetRef="sub_cus"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_chk=="international"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_chk_t_insp" name="Fragile / insured" sourceRef="g_chk" targetRef="t_insp"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_chk=="fragile_insured"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_chk_t_sort" name="Always" sourceRef="g_chk" targetRef="t_sort"/>
    <bpmn:sequenceFlow id="f_b_cerr_t_rto" sourceRef="b_cerr" targetRef="t_rto"/>
    <bpmn:sequenceFlow id="f_t_rto_end_rto" sourceRef="t_rto" targetRef="end_rto"/>
    <bpmn:sequenceFlow id="f_sub_cus_g_cj" sourceRef="sub_cus" targetRef="g_cj"/>
    <bpmn:sequenceFlow id="f_t_insp_g_cj" sourceRef="t_insp" targetRef="g_cj"/>
    <bpmn:sequenceFlow id="f_t_sort_g_cj" sourceRef="t_sort" targetRef="g_cj"/>
    <bpmn:sequenceFlow id="f_g_cj_g_dmg" sourceRef="g_cj" targetRef="g_dmg"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_cj=="ok"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_dmg_m_dmg" name="No" sourceRef="g_dmg" targetRef="m_dmg"/>
    <bpmn:sequenceFlow id="f_g_dmg_g_ins" name="Yes" sourceRef="g_dmg" targetRef="g_ins"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_dmg=="yes"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_ins_sub_cl" name="Yes: claim" sourceRef="g_ins" targetRef="sub_cl"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_ins=="yes_claim"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_ins_t_rec" name="No" sourceRef="g_ins" targetRef="t_rec"/>
    <bpmn:sequenceFlow id="f_t_rec_m_dmg" sourceRef="t_rec" targetRef="m_dmg"/>
    <bpmn:sequenceFlow id="f_sub_cl_end_cl" sourceRef="sub_cl" targetRef="end_cl"/>
    <bpmn:sequenceFlow id="f_m_dmg_m_try" sourceRef="m_dmg" targetRef="m_try"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${m_dmg=="ok"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_m_try_t_ofd" sourceRef="m_try" targetRef="t_ofd"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${m_try=="ok"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_t_ofd_t_del" sourceRef="t_ofd" targetRef="t_del"/>
    <bpmn:sequenceFlow id="f_t_del_g_out" sourceRef="t_del" targetRef="g_out"/>
    <bpmn:sequenceFlow id="f_b_addr_t_addr" sourceRef="b_addr" targetRef="t_addr"/>
    <bpmn:sequenceFlow id="f_t_addr_m_try" sourceRef="t_addr" targetRef="m_try"/>
    <bpmn:sequenceFlow id="f_g_out_t_close" name="Delivered" sourceRef="g_out" targetRef="t_close"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_out=="delivered"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_out_t_rts" name="Refused / COD failed" sourceRef="g_out" targetRef="t_rts"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_out=="refused_cod_failed"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_out_g_att" name="Recipient absent" sourceRef="g_out" targetRef="g_att"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_out=="recipient_absent"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_t_rts_end_rts" sourceRef="t_rts" targetRef="end_rts"/>
    <bpmn:sequenceFlow id="f_g_att_g_w" name="Yes" sourceRef="g_att" targetRef="g_w"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${g_att=="yes"}</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f_g_att_e_hold" name="No: attempts used up" sourceRef="g_att" targetRef="e_hold"/>
    <bpmn:sequenceFlow id="f_e_hold_t_rts" sourceRef="e_hold" targetRef="t_rts"/>
    <bpmn:sequenceFlow id="f_g_w_e_1d" sourceRef="g_w" targetRef="e_1d"/>
    <bpmn:sequenceFlow id="f_g_w_e_rpl" sourceRef="g_w" targetRef="e_rpl"/>
    <bpmn:sequenceFlow id="f_e_1d_m_try" sourceRef="e_1d" targetRef="m_try"/>
    <bpmn:sequenceFlow id="f_e_rpl_m_try" sourceRef="e_rpl" targetRef="m_try"/>
    <bpmn:sequenceFlow id="f_t_close_end_ok" sourceRef="t_close" targetRef="end_ok"/>
    <bpmn:association id="as_b_pay_t_refund" associationDirection="One" sourceRef="b_pay" targetRef="t_refund"/>
  </bpmn:process>
