{
  "schemaVersion": 16,
  "id": "OrderReview",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "components": [
    {
      "type": "text",
      "id": "intro",
      "text": "# Order verification\nReview the synthetic case details before completing this task."
    },
    {
      "type": "textfield",
      "id": "case",
      "key": "caseId",
      "label": "Case reference",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_customerRef",
      "key": "customerRef",
      "label": "customerRef",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_productId",
      "key": "productId",
      "label": "productId",
      "readonly": true
    },
    {
      "type": "number",
      "id": "context_quantity",
      "key": "quantity",
      "label": "quantity",
      "readonly": true
    },
    {
      "type": "number",
      "id": "context_orderTotal",
      "key": "orderTotal",
      "label": "orderTotal",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_deliveryPriority",
      "key": "deliveryPriority",
      "label": "deliveryPriority",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "notes",
      "key": "reviewNotes",
      "label": "Review notes / action taken",
      "validate": {
        "required": true
      }
    },
    {
      "type": "radio",
      "id": "approval",
      "key": "reviewDecision",
      "label": "Decision",
      "values": [
        {
          "label": "Approve / continue",
          "value": "Approve"
        },
        {
          "label": "Reject / refer",
          "value": "Reject"
        }
      ],
      "validate": {
        "required": true
      }
    }
  ]
}