<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Lab2_Order" targetNamespace="https://srm.edu/educational/labs" exporter="Camunda lab model generator" exporterVersion="1.0">
  <bpmn:process id="Lab2_Order" name="Lab 2 - E-commerce order" isExecutable="true">
    <bpmn:startEvent id="Start" name="Order received">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Validate" name="Validate order / check stock / total">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="order-validate" retries="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Valid order?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Stock" name="Stock available?" default="Flow_11">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Priority" name="Determine delivery priority">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="OrderPriority" resultVariable="deliveryPriority" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="HighValue" name="Total &gt;= 50000?" default="Flow_14">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Review" name="Verify high-value order">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="=reviewer"/>
        <zeebe:formDefinition formId="OrderReview" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ReviewRoute" name="Reviewer approved?" default="Flow_17">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Payment" name="REST simulated payment">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type"/>
          <zeebe:input source="POST" target="method"/>
          <zeebe:input source="=mockBaseUrl + &quot;/mock/payment&quot;" target="url"/>
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="={caseId:caseId,paymentToken:paymentToken,orderTotal:orderTotal}" target="body"/>
          <zeebe:input source="=5" target="connectionTimeoutInSeconds"/>
          <zeebe:input source="=10" target="readTimeoutInSeconds"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={paymentStatus:response.body.paymentStatus}"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PaymentRoute" name="Payment paid?" default="Flow_20">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Fulfilled" name="Record Fulfilled">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Fulfilled&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="FulfilledEnd" name="Fulfilled">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Fulfilled" targetRef="FulfilledEnd" name=""/>
    <bpmn:serviceTask id="Declined" name="Record Payment declined">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Payment declined&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="DeclinedEnd" name="Payment declined">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Declined" targetRef="DeclinedEnd" name=""/>
    <bpmn:serviceTask id="OutStock" name="Record Out of stock">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Out of stock&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="OutStockEnd" name="Out of stock">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="OutStock" targetRef="OutStockEnd" name=""/>
    <bpmn:serviceTask id="Invalid" name="Record Invalid order">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Invalid order&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="InvalidEnd" name="Invalid order">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Invalid" targetRef="InvalidEnd" name=""/>
    <bpmn:serviceTask id="Rejected" name="Record Review rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Review rejected&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="RejectedEnd" name="Review rejected">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Rejected" targetRef="RejectedEnd" name=""/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Start" targetRef="Validate" name=""/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Validate" targetRef="Valid" name=""/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Valid" targetRef="Stock" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Valid" targetRef="Invalid" name="Invalid"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Stock" targetRef="Priority" name="In stock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=stockAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Stock" targetRef="OutStock" name="Unavailable"/>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Priority" targetRef="HighValue" name=""/>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="HighValue" targetRef="Review" name="High value">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=orderTotal &gt;= 50000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="HighValue" targetRef="Payment" name="Standard value"/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Review" targetRef="ReviewRoute" name=""/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="ReviewRoute" targetRef="Payment" name="Approve">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "Approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="ReviewRoute" targetRef="Rejected" name="Reject"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Payment" targetRef="PaymentRoute" name=""/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="PaymentRoute" targetRef="Fulfilled" name="Paid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=paymentStatus = "Paid"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="PaymentRoute" targetRef="Declined" name="Not paid"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Lab2_Order">
