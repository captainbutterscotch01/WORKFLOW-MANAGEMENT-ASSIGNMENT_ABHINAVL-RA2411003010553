<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Lab3_Hospital" targetNamespace="https://srm.edu/educational/labs" exporter="Camunda lab model generator" exporterVersion="1.0">
  <bpmn:process id="Lab3_Hospital" name="Lab 3 - Synthetic patient triage" isExecutable="true">
    <bpmn:startEvent id="Start" name="Synthetic request">
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Register" name="Validate registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hospital-register" retries="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Valid" name="Valid request?" default="Flow_9">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Triage" name="Educational triage rules">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="HospitalTriage" resultVariable="urgencyCategory" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Route" name="Triage category?" default="Flow_13">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Urgent" name="Immediate human assessment">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="=reviewer"/>
        <zeebe:formDefinition formId="UrgentAssessment" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Assessed" name="Record Human assessment recorded">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Human assessment recorded&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="AssessedEnd" name="Human assessment recorded">
      <bpmn:incoming>Flow_1</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Assessed" targetRef="AssessedEnd" name=""/>
    <bpmn:userTask id="PriorityReview" name="Priority staff review">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="=reviewer"/>
        <zeebe:formDefinition formId="HospitalReview" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="PriorityRoute" name="Continue scheduling?" default="Flow_17">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Referred" name="Record Referred to staff">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Referred to staff&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="ReferredEnd" name="Referred to staff">
      <bpmn:incoming>Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Referred" targetRef="ReferredEnd" name=""/>
    <bpmn:serviceTask id="Availability" name="Worker requests availability">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hospital-availability" retries="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Slots" name="REST refresh available slots">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type"/>
          <zeebe:input source="POST" target="method"/>
          <zeebe:input source="=mockBaseUrl + &quot;/mock/scheduling&quot;" target="url"/>
          <zeebe:input source="={&quot;Content-Type&quot;: &quot;application/json&quot;}" target="headers"/>
          <zeebe:input source="={caseId:caseId,patientRef:patientRef,appointmentPreference:appointmentPreference,slotScenario:slotScenario}" target="body"/>
          <zeebe:input source="=5" target="connectionTimeoutInSeconds"/>
          <zeebe:input source="=10" target="readTimeoutInSeconds"/>
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={availableSlots:response.body.availableSlots,slotsAvailable:response.body.slotsAvailable}"/>
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="SlotRoute" name="Slot available?" default="Flow_21">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="NoSlots" name="Staff review: no suitable slot">
      <bpmn:extensionElements>
        <zeebe:userTask/>
        <zeebe:assignmentDefinition assignee="=reviewer"/>
        <zeebe:formDefinition formId="NoSlotReview" bindingType="deployment"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Waitlisted" name="Record Staff follow-up required">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Staff follow-up required&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="WaitlistedEnd" name="Staff follow-up required">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Waitlisted" targetRef="WaitlistedEnd" name=""/>
    <bpmn:serviceTask id="Book" name="Book first available mock slot">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="hospital-book" retries="1"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Booked" name="Record Booked">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Booked&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="BookedEnd" name="Booked">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Booked" targetRef="BookedEnd" name=""/>
    <bpmn:serviceTask id="Invalid" name="Record Invalid registration">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="record-outcome" retries="1"/>
        <zeebe:ioMapping>
          <zeebe:input source="=&quot;Invalid registration&quot;" target="finalStatus"/>
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="InvalidEnd" name="Invalid registration">
      <bpmn:incoming>Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Invalid" targetRef="InvalidEnd" name=""/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Start" targetRef="Register" name=""/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Register" targetRef="Valid" name=""/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Valid" targetRef="Triage" name="Valid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=registrationValid = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Valid" targetRef="Invalid" name="Invalid"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Triage" targetRef="Route" name=""/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Route" targetRef="Urgent" name="Urgent">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgencyCategory = "Urgent Assessment"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Route" targetRef="PriorityReview" name="Priority">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=urgencyCategory = "Priority Review"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Route" targetRef="Availability" name="Routine"/>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Urgent" targetRef="Assessed" name=""/>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="PriorityReview" targetRef="PriorityRoute" name=""/>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="PriorityRoute" targetRef="Availability" name="Continue">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=reviewDecision = "Approve"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="PriorityRoute" targetRef="Referred" name="Refer"/>
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Availability" targetRef="Slots" name=""/>
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Slots" targetRef="SlotRoute" name=""/>
    <bpmn:sequenceFlow id="Flow_20" sourceRef="SlotRoute" targetRef="Book" name="Available">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=slotsAvailable = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_21" sourceRef="SlotRoute" targetRef="NoSlots" name="None"/>
    <bpmn:sequenceFlow id="Flow_22" sourceRef="NoSlots" targetRef="Waitlisted" name=""/>
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Book" targetRef="Booked" name=""/>
  </bpmn:process>
