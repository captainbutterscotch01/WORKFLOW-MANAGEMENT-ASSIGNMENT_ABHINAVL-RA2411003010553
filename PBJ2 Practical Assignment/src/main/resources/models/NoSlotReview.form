{
  "schemaVersion": 16,
  "id": "NoSlotReview",
  "type": "default",
  "executionPlatform": "Camunda Cloud",
  "executionPlatformVersion": "8.8.0",
  "components": [
    {
      "type": "text",
      "id": "intro",
      "text": "# No slots - arrange staff follow-up\nReview the synthetic case details before completing this task."
    },
    {
      "type": "textfield",
      "id": "case",
      "key": "caseId",
      "label": "Case reference",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_patientRef",
      "key": "patientRef",
      "label": "patientRef",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_symptomsSummary",
      "key": "symptomsSummary",
      "label": "symptomsSummary",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_appointmentPreference",
      "key": "appointmentPreference",
      "label": "appointmentPreference",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "context_urgencyCategory",
      "key": "urgencyCategory",
      "label": "urgencyCategory",
      "readonly": true
    },
    {
      "type": "textfield",
      "id": "notes",
      "key": "reviewNotes",
      "label": "Review notes / action taken",
      "validate": {
        "required": true
      }
    },
    {
      "type": "checkbox",
      "id": "ack",
      "key": "staffActionRecorded",
      "label": "I have recorded the human assessment or follow-up action",
      "validate": {
        "required": true
      }
    }
  ]
}