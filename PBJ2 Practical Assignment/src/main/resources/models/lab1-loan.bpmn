        <di:waypoint x="375.0" y="216.0"/><di:waypoint x="375.0" y="270.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="375.0" y="320.0"/><di:waypoint x="375.0" y="390.0"/><bpmndi:BPMNLabel><dc:Bounds x="402.0" y="344.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="350.0" y="295.0"/><di:waypoint x="115.0" y="295.0"/><di:waypoint x="115.0" y="390.0"/><bpmndi:BPMNLabel><dc:Bounds x="177.5" y="271.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="375.0" y="466.0"/><di:waypoint x="375.0" y="530.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="375.0" y="606.0"/><di:waypoint x="375.0" y="670.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_di" bpmnElement="Flow_10">
        <di:waypoint x="375.0" y="720.0"/><di:waypoint x="375.0" y="1080.0"/><bpmndi:BPMNLabel><dc:Bounds x="402.0" y="889.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="350.0" y="695.0"/><di:waypoint x="115.0" y="695.0"/><di:waypoint x="115.0" y="1080.0"/><bpmndi:BPMNLabel><dc:Bounds x="177.5" y="671.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="400.0" y="695.0"/><di:waypoint x="675.0" y="695.0"/><di:waypoint x="675.0" y="800.0"/><bpmndi:BPMNLabel><dc:Bounds x="482.5" y="671.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_di" bpmnElement="Flow_13">
        <di:waypoint x="675.0" y="876.0"/><di:waypoint x="675.0" y="940.0"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="650.0" y="965.0"/><di:waypoint x="375.0" y="965.0"/><di:waypoint x="375.0" y="1080.0"/><bpmndi:BPMNLabel><dc:Bounds x="457.5" y="941.0" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="675" y="990"/><di:waypoint x="675" y="1030"/><di:waypoint x="115" y="1030"/><di:waypoint x="115" y="1080"/><bpmndi:BPMNLabel><dc:Bounds x="340" y="1004" width="110" height="28"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
